# =====================================================================
# CIDSEC_CONST — Variables d'environnement (MODÈLE)
# FR: Copier ce fichier en `.env` puis adapter les valeurs.
#     `.env` est IGNORÉ par Git (.gitignore) : aucun secret dans le dépôt.
# EN: Copy this file to `.env` and adjust the values.
#     `.env` is Git-ignored: no secrets in the repository.
# =====================================================================

# --- PostgreSQL -------------------------------------------------------
# FR: Mot de passe du super-utilisateur Postgres (utilisé au 1er démarrage).
# EN: Postgres superuser password (used on first startup).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# FR: Identifiants des rôles créés par docker/postgres/init/01_init_databases.sql
# EN: Role credentials created by docker/postgres/init/01_init_databases.sql
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
HIVE_DB_USER=hive
HIVE_DB_PASSWORD=hive
SPARK_DB_USER=spark
SPARK_DB_PASSWORD=spark
POWERBI_DB_USER=powerbi
POWERBI_DB_PASSWORD=powerbi

# --- Airflow ----------------------------------------------------------
# FR: Clé Fernet (chiffrement des connexions Airflow). En production : `python -c
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key())"`.
#     Vide = acceptable uniquement en environnement de démo local.
# EN: Fernet key (Airflow connection encryption). Production: generate one.
#     Empty = acceptable only in a local demo environment.
AIRFLOW__CORE__FERNET_KEY=

# FR: Utilisateur admin de l'interface Airflow (créé par airflow-init).
# EN: Airflow UI admin user (created by airflow-init).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- API externes (aucune clé requise pour ces 2 API) -----------------
# EN: External APIs (no key required for these two)
OPEN_METEO_URL=https://archive-api.open-meteo.com/v1/archive
FRANKFURTER_URL=https://api.frankfurter.app
