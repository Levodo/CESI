# =====================================================================================
# .env.example — Variables d'environnement du projet / Project environment variables
#
# POURQUOI / WHY :
#   Centralise les parametres ajustables SANS toucher au docker-compose.yml.
#   Centralizes adjustable settings WITHOUT touching docker-compose.yml.
#
# COMMENT / HOW :
#   Copier ce fichier vers ".env" (meme dossier) : docker-compose lit .env automatiquement.
#   Copy this file to ".env" (same folder): docker-compose reads .env automatically.
#   Les valeurs ci-dessous sont celles par defaut du projet pedagogique.
#   The values below are the defaults of this teaching project.
# =====================================================================================

# Nom du projet compose (prefixe des conteneurs : cidsec-*)
# Compose project name (container prefix: cidsec-*)
COMPOSE_PROJECT_NAME=cidsec

# Utilisateur Airflow cree au demarrage / Airflow user created at startup
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=admin@cidsec.local

# NOTE : les mots de passe des bases (postgres/hive/spark/powerbi) sont dans
#        docker/postgres/init-db.sql — a changer AVANT le premier demarrage
#        si le projet sort du cadre purement pedagogique.
#        Database passwords live in docker/postgres/init-db.sql — change them
#        BEFORE first startup if the project leaves the purely teaching context.
